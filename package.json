{
  "name": "keurcook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:sortie": "NEXT_PUBLIC_SITE_URL=https://keurcook.com NEXT_TELEMETRY_DISABLED=1 npm run build && npm run test:sortie:controle",
    "test:sortie:controle": "tsx --test tests/sortie/*.test.ts",
    "prebuild": "node scripts/og-images.mjs && node scripts/images-responsives.mjs && tsx scripts/epingles.ts && tsx scripts/articles-veille.ts",
    "epingles": "tsx scripts/epingles.ts",
    "articles": "tsx scripts/articles-veille.ts",
    "verifier-produits": "tsx scripts/verifier-produits.ts",
    "pinterest:auth": "node scripts/pinterest-auth.mjs",
    "pinterest:secrets": "node scripts/pinterest-secrets.mjs",
    "pinterest:publier": "node scripts/pinterest-publier.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "marked": "^16.4.2",
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.143.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
