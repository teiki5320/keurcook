# En-têtes de sécurité servis par Cloudflare Pages sur toutes les pages.
# CSP : scripts, styles et images du site uniquement (Next.js a besoin de scripts en ligne) ;
# data: et blob: pour les textures du nuage de particules (Three.js).
# Veille actus : le fichier des actus et ses images, servis par teiki5320.github.io (connect-src et img-src seulement).
# Google (AdSense et message de consentement) : annonces, cadres, mesures et polices du message, rien d'autre.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://teiki5320.github.io https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://*.google.com https://*.gstatic.com https://*.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://teiki5320.github.io https://cloudflareinsights.com https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://*.google.com; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.adtrafficquality.google https://fundingchoicesmessages.google.com https://www.google.com; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fichiers de build versionnés : mis en cache longtemps.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Copie technique du site sur keurcook.pages.dev (et ses versions de publication) : jamais dans Google,
# seule keurcook.com doit être indexée.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Fichiers .txt créés par Next.js pour chaque page (navigation interne) : utiles au navigateur, pas à Google.
# Les .txt publics n'ont pas cet en-tête (règles « ! » ci-dessous) : ads.txt (AdSense), robots.txt et la clé IndexNow.
/*.txt
  X-Robots-Tag: noindex

/ads.txt
  ! X-Robots-Tag

/robots.txt
  ! X-Robots-Tag

/1966e925dc52073a412c1203dc2860be.txt
  ! X-Robots-Tag
