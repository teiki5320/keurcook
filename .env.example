# =====================================================================
# Alohash — variables d'environnement
# Copier ce fichier en .env.local (dev) et renseigner les mêmes variables
# dans Vercel (production).
# Sans DATABASE_URL, le site tourne en MODE DÉMO (données de src/lib/demo).
# =====================================================================

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Alohash
NEXT_PUBLIC_CONTACT_EMAIL=contact@alohash.fr

# --- Base de données Neon (PostgreSQL). Sur Vercel : Storage > Create Database > Neon,
# la variable est ajoutée automatiquement. Secret : serveur uniquement.
DATABASE_URL=

# --- Vercel Blob (photos des produits et des recettes envoyées depuis l'admin). Sur Vercel :
# Storage > Create > Blob (accès Public) > Connect : BLOB_STORE_ID et
# BLOB_WEBHOOK_PUBLIC_KEY sont ajoutées automatiquement (accès par OIDC).
# Hors Vercel (dev local) : BLOB_READ_WRITE_TOKEN à la place.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

# --- Espace admin (/admin) : mot de passe unique, long et difficile à deviner.
# Le changer déconnecte toutes les sessions ouvertes.
ADMIN_PASSWORD=

# --- Programme Partenaires Amazon : identifiant ajouté aux liens « Acheter » (par défaut kultiva-21).
NEXT_PUBLIC_AMAZON_TAG=

# --- Informations légales (mentions légales, conditions d'utilisation)
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_FORM=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_SIRET=
NEXT_PUBLIC_LEGAL_RCS=
NEXT_PUBLIC_LEGAL_VAT=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_LEGAL_PHONE=
# Hébergeur (par défaut : Vercel). Pour Netlify :
# "Netlify Inc., 512 2nd Street, Suite 200, San Francisco, CA 94107, États-Unis — netlify.com"
NEXT_PUBLIC_LEGAL_HOST=
NEXT_PUBLIC_LEGAL_HOST_NAME=
